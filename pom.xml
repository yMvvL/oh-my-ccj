<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.ccj</groupId>
  <artifactId>oh-my-ccj</artifactId>
  <version>0.1.0</version>
  <packaging>jar</packaging>

  <name>oh-my-ccj</name>
  <description>从零写成的纯 Java 21 编码代理运行时。</description>
  <url>https://github.com/yMvvL/oh-my-ccj</url>

  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/licenses/MIT</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>yMvvL</id>
      <name>yMvvL</name>
    </developer>
  </developers>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <!-- 构建写出的那个 jar。刻意做成可覆盖：`mvn package` 会截断这个文件，而截断一个 JVM 正在执行的
         jar 会杀掉那个 JVM。所以在本项目正在运行时重新构建，要用 `-Djar.name=ccj-next`，它绝不碰
         正在使用的 jar，新 jar 之后再改名到位。见 docs/BOOTSTRAP.md。 -->
    <jar.name>ccj</jar.name>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <jackson.version>2.18.2</jackson.version>
    <junit.version>5.11.4</junit.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>${jackson.version}</version>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>${jar.name}</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <!-- 版本写下来，而不是靠 Maven 的默认绑定。wrapper 固定了 Maven，所以默认值在实践中是稳定的，
             但读者核对不了「就是它编译的」——而 release 只有从这里才看得出来（见上面的 properties）。
             这个数字就是本 wrapper（Maven 3.9.16）自己会绑定的那个：写下来是为了让读者能核对，不是
             为了换一个版本。 -->
        <version>3.15.0</version>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
        <configuration>
          <trimStackTrace>false</trimStackTrace>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>com.ccj.agent.cli.Main</mainClass>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>

    </plugins>
  </build>
</project>
